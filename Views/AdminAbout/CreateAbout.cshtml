@{
    ViewBag.Title = "CreateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Hakkımızda Ekleme Sayfası</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="./">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Hakkımızda</li>
            <li class="breadcrumb-item active" aria-current="page">Hakkımızda İşlemleri</li>
        </ol>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <!-- Form Basic -->
            <div class="card mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Ekleme Paneli</h6>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="form-group">
                            <label for="exampleInputAbout">Başlık</label>
                            <input type="text" class="form-control" name="Title" id="titleInput" aria-describedby="emailHelp"
                                   placeholder=" Başlık Giriniz">
                        </div>
                        <div class="form-group">
                            <label for="DescriptionInput">Açıklama</label>
                      <textarea class="form-control" name="Description" rows="3" style="resize: vertical"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="exampleInputCategory">Resim</label>
                            <input type="text" class="form-control" name="ImageUrl" id="ImageUrlInput" aria-describedby="emailHelp"
                                   placeholder="Resim Seçiniz">
                        </div>
                        <button type="submit" class="btn btn-primary">Hakkımızda Ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>