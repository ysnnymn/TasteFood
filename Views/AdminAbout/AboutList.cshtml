@model List<TasteFoodIt.Entities.About>

@{
    ViewBag.Title = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Hakkımızda Sayfası</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="./">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Hakkımızda</li>
            <li class="breadcrumb-item active" aria-current="page">Hakkımızda İşlemleri</li>
        </ol>
    </div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <!-- Simple Tables -->
            <div class="card">
                
                <div class="table-responsive">
                    <table class="table align-items-center table-flush">
                        <thead class="thead-light">
                        <tr>
                            <th>Hakkımızda Id</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Resim</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AboutId</td>
                                <td>@item.Title</td>
                                <td>
                                    @{
                                        var shortText = item.Description?.Length > 60
                                            ? item.Description.Substring(0, 60) + "..."
                                            : item.Description;
                                    }

                                    <!-- Kısaltılmış Metin -->
                                    <div>
                                        @shortText

                                        @if(item.Description.Length > 50)
                                        {
                                            <a class="text-primary ms-2" style="cursor:pointer;"
                                               data-bs-toggle="collapse"
                                               href="#desc_@item.AboutId">
                                                Devamını Oku
                                            </a>
                                        }
                                    </div>

                                    <!-- TAM AÇIKLAMA - KUTU İÇİNDE -->
                                    <div class="collapse mt-2" id="desc_@item.AboutId">
                                        <div style="background:#f8f9fa; padding:15px; border-radius:8px; border:1px solid #ddd;">
                                            @item.Description
                                        </div>
                                    </div>
                                </td>

                                <td><img src="@item.ImageUrl" width="80" /></td>
                              
                                <td>  <form asp-controller="AdminAbout" asp-action="DeleteAbout" method="post"><input type="hidden" name="id" value="@item.AboutId">
                                        <button type="submit" class="btn btn-danger">Sil</button>
                                    </form>
                                </td>
                              
                                <td><a href="/AdminAbout/UpdateAbout/@item.AboutId" class="btn btn-success">Güncelle</a></td>
                            </tr>
                          
                        }
                      
                        </tbody>
                    </table>
                  @if (@Model.Count == 0)
                    { <a href="/AdminAbout/CreateAbout" class="btn btn-primary">Hakkımızda Ekle</a>
                        
                    }
                   
                </div>
                <div class="card-footer"></div>
            </div>
        </div>
    </div>
    <!--Row-->
    <!-- Modal Logout -->
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
