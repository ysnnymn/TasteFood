@model List<TasteFoodIt.Entities.Reservation>

@{
    ViewBag.Title = "ReservationList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = (ViewBag.CurrentPage - 1) * 10; 
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Rezervasyon Listesi</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Rezervasyonlar</li>
            <li class="breadcrumb-item active" aria-current="page">Rezervasyon İşlemleri</li>
        </ol>
    </div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card">

                <div class="table-responsive">
                    <table class="table align-items-center table-flush">
                        <thead class="thead-light">
                        <tr>
                            <th>#</th>
                            <th>Ad-Soyad</th>
                            <th>Email</th>
                            <th>Telefon No</th>
                            <th>Tarih</th>
                            <th>Saat</th>
                            <th>Kişi Sayısı</th>
                            <th>Rezervasyon Durumu</th>
                            <th>Güncelle</th>
                        
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>@item.Name</td>

                          
                                <td>@item.Email</td>

                                <td>@item.Phone</td>
                                <td>@item.ReservationDate.ToString("yyyy-M-d dddd") </td>
                                <td>@item.Time</td>

                                <td>
                               @item.GuestCount
                                </td>

                                <td>
                                    @if (item.ReservationStatus=="Aktif")
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else if (item.ReservationStatus == "İptal Edildi")
                                    {
                                        <span class="badge bg-danger">İptal Edildi</span>
                                    }
                                    else
                                    {
                                        <form 
                                            asp-controller="AdminReservation"
                                            asp-action="MarkIsRead"
                                            method="post">

                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ReservationId">

                                            <button type="submit"
                                                    class="badge bg-warning border-0">
                                                Pasif
                                            </button>
                                        </form>
                                    }
                                    @if (item.ReservationStatus != "İptal Edildi")
                                    {
                                        <form asp-controller="AdminReservation"
                                              asp-action="DeleteReservation"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ReservationId">

                                            <button type="submit"
                                                    class="badge bg-danger border-0 ms-2">
                                                İptal Et
                                            </button>
                                        </form>
                                    }
                                    
                                </td>
                                <td><a href="/AdminReservation/UpdateReservation/@item.ReservationId" class="btn btn-success">Güncelle</a></td>

                                

                            </tr>
                        }
                        </tbody>
                    </table>

             
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center">

        <!-- Önceki Sayfa -->
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="/AdminReservation/ReservationList?page=@(ViewBag.CurrentPage - 1)">Önceki</a>
        </li>

        <!-- Sayfa Numaraları -->
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="/AdminReservation/ReservationList?page=@i">@i</a>
            </li>
        }

        <!-- Sonraki Sayfa -->
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" href="/AdminReservation/ReservationList?page=@(ViewBag.CurrentPage + 1)">Sonraki</a>
        </li>

    </ul>
</nav>
