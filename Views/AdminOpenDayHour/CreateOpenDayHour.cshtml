@model TasteFoodIt.Entities.OpenDayHour

@{
    ViewBag.Title = "Create Open Day Hour";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <h3>Yeni Gün & Saat Ekle</h3>
    <hr />

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Gün Adı</label>
            <input type="text" class="form-control" name="DayName" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Çalışma Saat Aralığı</label>
            <input type="text" class="form-control" name="OpenHourRange" placeholder="09:00 - 22:00" required />
        </div>

        <button class="btn btn-success" type="submit">Kaydet</button>
        <a href="/AdminOpenDayHour/OpenDayHourList" class="btn btn-secondary">Geri</a>

    </form>

</div>
