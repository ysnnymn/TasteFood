@model List<TasteFoodIt.Entities.OpenDayHour>

@{
    ViewBag.Title = "Open Day & Hour List";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Çalışma Gün & Saatleri</h3>
        <a href="/AdminOpenDayHour/CreateOpenDayHour" class="btn btn-primary">Yeni Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Gün</th>
            <th>Çalışma Saati</th>
            <th style="width:150px;">İşlemler</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OpenDayHourId</td>
                <td>@item.DayName</td>
                <td>@item.OpenHourRange</td>
                <td>
                    <a class="btn btn-sm btn-warning" 
                       href="/AdminOpenDayHour/UpdateOpenDayHour/@item.OpenDayHourId">Düzenle</a>
                        
                    <form method="post" action="/AdminOpenDayHour/DeleteOpenDayHour" style="display:inline-block;">
                        <input type="hidden" name="id" value="@item.OpenDayHourId" />
                        <button class="btn btn-sm btn-danger" type="submit">Sil</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

</div>