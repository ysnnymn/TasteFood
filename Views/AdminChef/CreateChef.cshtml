@model TasteFoodIt.Entities.Chef

@{
    ViewBag.Title = "Yeni Chef Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Yeni Chef Ekle</h2>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Ad Soyad</label>
            <input class="form-control" asp-for="NameSurname" />
        </div>

        <div class="mb-3">
            <label class="form-label">Ünvan</label>
            <input class="form-control" asp-for="Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fotoğraf URL</label>
            <input class="form-control" asp-for="ImageUrl" />
        </div>

        <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea rows="4" class="form-control" asp-for="Description"></textarea>
        </div>

        <button class="btn btn-success">Kaydet</button>
        <a href="/AdminChef/ChefList" class="btn btn-secondary">Geri</a>

    </form>
</div>
