@model List<TasteFoodIt.Entities.Chef>

@{
    ViewBag.Title = "Chef Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Chef Listesi</h2>

    <a href="/AdminChef/CreateChef" class="btn btn-primary mb-3">Yeni Chef Ekle</a>

    <table class="table table-bordered table-hover">
        <thead>
        <tr>
            <th>#</th>
            <th>Fotoğraf</th>
            <th>Ad Soyad</th>
            <th>Ünvan</th>
            <th>Açıklama</th>
            <th class="text-center">İşlemler</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ChefId</td>

                <td>
                    <img src="@item.ImageUrl" width="70" class="rounded" />
                </td>

                <td>@item.NameSurname</td>
                <td>@item.Title</td>
                <td>@item.Description</td>

                <td class="text-center">
                    <a href="/AdminChef/UpdateChef/@item.ChefId" class="btn btn-warning btn-sm">
                        Güncelle
                    </a>

                    <form method="post" action="/AdminChef/DeleteChef/@item.ChefId"
                          style="display:inline-block">
                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('Silmek istiyor musunuz?')">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
