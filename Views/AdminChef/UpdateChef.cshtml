@model TasteFoodIt.Entities.Chef

@{
    ViewBag.Title = "Chef Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-3">Chef Güncelle</h2>

    <form method="post">
        <input type="hidden" asp-for="ChefId" />

        <div class="mb-3">
            <label class="form-label">Ad Soyad</label>
            <input class="form-control" asp-for="NameSurname" />
        </div>

        <div class="mb-3">
            <label class="form-label">Ünvan</label>
            <input class="form-control" asp-for="Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fotoğraf URL</label>
            <input class="form-control" asp-for="ImageUrl" />
        </div>

        <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" rows="4" asp-for="Description"></textarea>
        </div>

        <button class="btn btn-primary">Güncelle</button>
        <a href="/AdminChef/ChefList" class="btn btn-secondary">Geri</a>
    </form>
</div>