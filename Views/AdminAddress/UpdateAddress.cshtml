@model TasteFoodIt.Entities.Address

@{
    ViewBag.Title = "UpdateAddress";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" id="container-wrapper">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Adres Güncelleme</h1>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h6 class="m-0 font-weight-bold text-primary">Adres Bilgilerini Güncelle</h6>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden" name="AddressId" value="@Model.AddressId" />

                <div class="form-group">
                    <label>Açıklama</label>
                    <textarea class="form-control" name="Description" rows="3">@Model.Description</textarea>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" class="form-control" name="Email" value="@Model.Email" />
                </div>

                <div class="form-group">
                    <label>Telefon</label>
                    <input type="text" class="form-control" name="Phone" value="@Model.Phone" />
                </div>

                <button class="btn btn-success">Güncelle</button>

            </form>

        </div>
    </div>

</div>
