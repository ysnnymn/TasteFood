@model List<TasteFoodIt.Entities.Product>

@{
    ViewBag.Title = "ProductList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = (ViewBag.CurrentPage - 1) * 10; // Sayfa sayısına göre numara
}

<div class="container-fluid" id="container-wrapper">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Ürün Listesi</h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin">Ana Sayfa</a></li>
            <li class="breadcrumb-item">Ürünler</li>
            <li class="breadcrumb-item active" aria-current="page">Ürün İşlemleri</li>
        </ol>
    </div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card">

                <div class="table-responsive">
                    <table class="table align-items-center table-flush">
                        <thead class="thead-light">
                        <tr>
                            <th>#</th>
                            <th>Ürün Adı</th>
                            <th>Kategori</th>
                            <th>Açıklama</th>
                            <th>Fiyat</th>
                            <th>Resim</th>
                            <th>Durum</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>@item.ProductName</td>

                                <!-- Kategori Adı (Category Include edilirse çalışır) -->
                                <td>@item.Category?.CategoryName</td>

                                <td>@item.Description</td>
                                <td>@item.Price ₺</td>

                                <td>
                                    <img src="@item.ImageUrl" width="70" class="rounded"/>
                                </td>

                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        @(item.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>

                                <!-- Sil -->
                                <td>
                                    <form asp-controller="AdminProduct" asp-action="DeleteProduct" method="post">
                                        <input type="hidden" name="id" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                    </form>
                                </td>

                                <!-- Güncelle -->
                                <td>
                                    <a href="/AdminProduct/UpdateProduct/@item.ProductId" class="btn btn-success btn-sm">Güncelle</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>

                    <a href="/AdminProduct/CreateProduct" class="btn btn-primary mt-3">Yeni Ürün Ekle</a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center">

        <!-- Önceki Sayfa -->
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="/AdminProduct/ProductList?page=@(ViewBag.CurrentPage - 1)">Önceki</a>
        </li>

        <!-- Sayfa Numaraları -->
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="/AdminProduct/ProductList?page=@i">@i</a>
            </li>
        }

        <!-- Sonraki Sayfa -->
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" href="/AdminProduct/ProductList?page=@(ViewBag.CurrentPage + 1)">Sonraki</a>
        </li>

    </ul>
</nav>
